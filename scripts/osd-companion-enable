#!/bin/bash

set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
source_dir=$repo_dir/companions/osd
plugin_id=rblalock.omarchy-island-osd
plugin_root=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins
target=$plugin_root/$plugin_id
marker=.omarchy-island-osd-local-source

rescan_plugins() {
  local attempt
  for attempt in {1..30}; do
    if OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell shell rescanPlugins >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  echo "Omarchy shell did not become ready to rescan plugins" >&2
  return 1
}

wait_for_shell() {
  local attempt consecutive=0
  for attempt in {1..50}; do
    if OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell shell ping >/dev/null 2>&1; then
      consecutive=$((consecutive + 1))
      (( consecutive >= 5 )) && return 0
    else
      consecutive=0
    fi
    sleep 0.1
  done
  return 1
}

plugin_status() {
  OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy plugin list 2>/dev/null \
    | awk -v id="$plugin_id" 'NR > 1 && $1 == id { print $2; exit }'
}

omarchy-plugin-validate "$repo_dir"
mkdir -p "$plugin_root"

if [[ -L $target ]]; then
  installed_source=$(readlink -f -- "$target")
  if [[ $installed_source != "$source_dir" ]]; then
    echo "Refusing to replace plugin symlink: $target -> $installed_source" >&2
    exit 1
  fi
elif [[ -e $target ]]; then
  if [[ ! -f $target/$marker ]] || [[ $(<"$target/$marker") != "$source_dir" ]]; then
    echo "Refusing to replace unmanaged plugin path: $target" >&2
    exit 1
  fi
fi

stage=$(mktemp -d "$plugin_root/.$plugin_id.XXXXXXXX")
old_target=""
old_link=""
activation_complete=0
target_replaced=0
cleanup() {
  local status=$?
  [[ -d ${stage:-} ]] && rm -rf -- "$stage"
  if (( ! activation_complete && target_replaced )); then
    if [[ -d $target && -f $target/$marker && $(<"$target/$marker") == "$source_dir" ]]; then
      rm -rf -- "$target"
    fi
    if [[ -n $old_target && -e $old_target && ! -e $target ]]; then
      mv -- "$old_target" "$target"
    elif [[ -n $old_link && ! -e $target && ! -L $target ]]; then
      ln -s -- "$old_link" "$target"
    else
      omarchy plugin disable "$plugin_id" >/dev/null 2>&1 || true
    fi
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  fi
  return "$status"
}
trap cleanup EXIT

cp -a -- "$source_dir/OsdBridge.qml" "$source_dir/OsdFallback.qml" \
  "$source_dir/OsdModel.js" "$stage/"
cp -a -- "$source_dir/manifest.example.json" "$stage/manifest.json"
printf '%s\n' "$source_dir" >"$stage/$marker"
omarchy-plugin-validate "$stage"

if [[ -L $target ]]; then
  old_link=$(readlink -- "$target")
  unlink -- "$target"
  target_replaced=1
elif [[ -d $target ]]; then
  old_target="$plugin_root/.$plugin_id.previous.$$"
  mv -- "$target" "$old_target"
  target_replaced=1
fi
(( target_replaced )) || target_replaced=1
mv -- "$stage" "$target"
stage=""

rescan_plugins
wait_for_shell || {
  echo "Omarchy shell did not stabilize after rescanning plugins" >&2
  exit 1
}
discovered_status=""
for _attempt in {1..30}; do
  discovered_status=$(plugin_status || true)
  [[ -z $discovered_status ]] || break
  sleep 0.1
done
if [[ -z $discovered_status ]]; then
  echo "Plugin registry did not discover $plugin_id after rescan" >&2
  exit 1
fi
if [[ $discovered_status != enabled ]]; then
  # Enabling rewrites shell configuration and can reload the plugin before the
  # CLI receives its reply. Reconcile against the registry before deciding the
  # idempotent request failed.
  omarchy plugin enable "$plugin_id" >/dev/null 2>&1 || true
  wait_for_shell || true
  [[ $(plugin_status || true) == enabled ]] || {
    echo "Failed to enable $plugin_id" >&2
    exit 1
  }
fi
activation_complete=1
[[ -z $old_target ]] || rm -rf -- "$old_target"
omarchy restart shell
echo "Omarchy Island OSD companion is enabled and refreshed; disabling it restores stock omarchy.osd"
